<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.13</version>
        <relativePath/>
    </parent>

    <groupId>com.animallocket</groupId>
    <artifactId>animal-locket</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Animal Locket</name>
    <description>Aggregator: phiên bản Spring Boot/Cloud, Java và dependencyManagement dùng chung cho mọi module.</description>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <!-- Chỉ dùng cho test: client cũ hơn bỏ qua im lặng test tích hợp trên Docker 29. -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <module>libs/common</module>
        <module>libs/outbox-jpa</module>
        <module>infra/config-server</module>
        <module>infra/eureka-server</module>
        <module>infra/api-gateway</module>
        <module>services/user-service</module>
        <module>services/media-service</module>
        <module>services/post-service</module>
        <module>services/notification-service</module>
        <module>services/discovery-service</module>
        <module>services/chat-service</module>
        <module>services/billing-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.animallocket</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.animallocket</groupId>
                <artifactId>outbox-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
